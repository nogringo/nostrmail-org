---
interface DnsRecord {
	type: string;
	name: string;
	value?: string;
	placeholder?: string;
	note?: string;
}
interface Props {
	records: DnsRecord[];
}
const { records } = Astro.props;
---
<table class="dns-table">
	<thead>
		<tr>
			<th scope="col">Type</th>
			<th scope="col">Name</th>
			<th scope="col">Value</th>
		</tr>
	</thead>
	<tbody>
		{records.map((r) => (
			<tr>
				<td class="dns-type"><span>{r.type}</span></td>
				{[r.name, r.value].map((text, i) => (
					<td class={i === 0 ? 'dns-name' : 'dns-value'}>
						{text === undefined ? (
							<span class="dns-placeholder">{r.placeholder}</span>
						) : (
							<button type="button" class="dns-copy" title="Copy">
								<code data-domain-tpl>{text}</code>
								<svg class="icon-copy" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="13" height="13" x="9" y="9" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
								<svg class="icon-check" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
							</button>
						)}
						{i === 1 && r.note && <span class="dns-note">{r.note}</span>}
					</td>
				))}
			</tr>
		))}
	</tbody>
</table>

<style>
	.dns-table {
		width: 100%;
		border-collapse: separate;
		border-spacing: 0;
		background: var(--code-bg);
		border: 1px solid var(--border);
		border-radius: 12px;
		overflow: hidden;
		font-size: 0.85rem;
	}
	th {
		text-align: left;
		font-size: 0.7rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--muted);
		padding: 12px 16px;
		border-bottom: 1px solid var(--border);
	}
	td {
		padding: 14px 16px;
		vertical-align: baseline;
		border-top: 1px solid var(--border);
	}
	tbody tr:first-child td {
		border-top: 0;
	}
	.dns-type {
		width: 1%;
		white-space: nowrap;
	}
	.dns-type span {
		display: inline-block;
		min-width: 48px;
		text-align: center;
		font-family: 'Fira Code', monospace;
		font-size: 0.75rem;
		font-weight: 600;
		color: var(--accent-protocol);
		background: rgba(139, 92, 246, 0.1);
		padding: 2px 8px;
		border-radius: 6px;
	}
	.dns-name {
		width: 36%;
	}
	.dns-copy {
		display: inline-flex;
		align-items: flex-start;
		gap: 10px;
		max-width: 100%;
		margin: -4px -8px;
		padding: 4px 8px;
		font: inherit;
		text-align: left;
		color: var(--code-fg);
		background: none;
		border: 0;
		border-radius: 6px;
		cursor: pointer;
		transition: background 0.2s ease;
	}
	.dns-copy:hover {
		background: rgba(139, 92, 246, 0.08);
	}
	.dns-copy:focus-visible {
		outline: 2px solid var(--accent-protocol);
		outline-offset: 0;
	}
	.dns-copy code {
		font-family: 'Fira Code', monospace;
		font-variant-ligatures: none;
		line-height: 1.5;
		overflow-wrap: anywhere;
	}
	.dns-copy svg {
		flex-shrink: 0;
		margin-top: 0.2em;
		color: var(--muted);
		opacity: 0.5;
		transition: opacity 0.2s ease, color 0.2s ease;
	}
	.dns-copy:hover svg,
	.dns-copy:focus-visible svg {
		opacity: 1;
		color: var(--accent-protocol);
	}
	.dns-copy .icon-check,
	.dns-copy.copied .icon-copy {
		display: none;
	}
	.dns-copy.copied .icon-check {
		display: block;
		opacity: 1;
		color: var(--accent-protocol);
	}
	.dns-placeholder {
		display: inline-block;
		font-size: 0.8rem;
		font-style: italic;
		color: var(--muted);
		border: 1px dashed var(--muted);
		border-radius: 6px;
		padding: 1px 8px;
	}
	.dns-note {
		display: block;
		margin-top: 6px;
		font-size: 0.8rem;
		line-height: 1.4;
		color: var(--muted);
	}

	@media (max-width: 640px) {
		thead {
			display: none;
		}
		tbody,
		td {
			display: block;
		}
		tr {
			display: grid;
			grid-template-columns: auto 1fr;
			gap: 8px 12px;
			align-items: baseline;
			padding: 14px;
		}
		tbody tr + tr {
			border-top: 1px solid var(--border);
		}
		td {
			padding: 0;
			border: 0;
		}
		.dns-type,
		.dns-name {
			width: auto;
		}
		.dns-value {
			grid-column: 1 / -1;
		}
		.dns-value::before {
			content: 'Value';
			display: block;
			margin-bottom: 4px;
			font-size: 0.65rem;
			font-weight: 700;
			text-transform: uppercase;
			letter-spacing: 0.06em;
			color: var(--muted);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.dns-copy,
		.dns-copy svg {
			transition: none;
		}
	}
</style>

<script>
	function selectForManualCopy(el: HTMLElement): boolean {
		const range = document.createRange();
		range.selectNodeContents(el);
		const sel = window.getSelection();
		sel?.removeAllRanges();
		sel?.addRange(range);
		try {
			return document.execCommand('copy');
		} catch {
			return false;
		}
	}

	document.addEventListener('click', async (e) => {
		const btn = (e.target as HTMLElement).closest('.dns-copy') as HTMLButtonElement | null;
		const code = btn?.querySelector('code');
		if (!btn || !code) return;
		let ok = true;
		try {
			await navigator.clipboard.writeText(code.textContent || '');
		} catch {
			ok = selectForManualCopy(code);
		}
		if (!ok) return;
		btn.classList.add('copied');
		window.setTimeout(() => btn.classList.remove('copied'), 1500);
	});
</script>
